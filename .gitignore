# Backend and frontend each carry their own more specific .gitignore
# (backend/.gitignore, frontend/.gitignore). These are non-anchored
# fallbacks so nothing risky slips in from repo root either.
.venv/
venv/
__pycache__/
*.pyc
.env
.env.example
db.sqlite3
media/
staticfiles/
.pytest_cache/
*.egg-info/
node_modules/
dist/
